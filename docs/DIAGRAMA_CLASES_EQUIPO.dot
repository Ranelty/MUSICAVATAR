digraph G {
graph [rankdir=TB,bgcolor="white",dpi=150,nodesep="0.7",ranksep="0.9",splines=polyline,pad="0.3",label="MUSICAVATAR — MÓDULOS DEL EQUIPO",labelloc="t",fontsize=22,fontname="DejaVu Sans",fontcolor="#352344"];
node [shape=plaintext];
edge [color="#877494",penwidth=1.2,arrowsize=0.7];
"MusicavatarWindow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#ebddfa" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>MusicavatarWindow</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+db: MusicDatabase</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+avatar: AvatarCanvas</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+show_customizer()</FONT></TD></TR></TABLE>>];
"CreditsDialog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#fff4e5" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>CreditsDialog</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+__init__(parent)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+accept()</FONT></TD></TR></TABLE>>];
"BackgroundControls" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#e9f4ee" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>BackgroundControls</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+background_file: Path</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+choose_image()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+reset_background()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+save_options()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+_apply_image()</FONT></TD></TR></TABLE>>];
"AvatarCanvas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>AvatarCanvas</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_background_image(...)</FONT></TD></TR></TABLE>>];
"MusicDatabase" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>MusicDatabase</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+get_setting(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_setting(...)</FONT></TD></TR></TABLE>>];
{rank=same; "CreditsDialog";"BackgroundControls";}
"MusicavatarWindow" -> "CreditsDialog" [label="abre: Christofer",fontname="DejaVu Sans",fontsize=10];
"MusicavatarWindow" -> "BackgroundControls" [label="instala: Ángel Mario",fontname="DejaVu Sans",fontsize=10];
"BackgroundControls" -> "AvatarCanvas" [label="aplica imagen",fontname="DejaVu Sans",fontsize=10];
"BackgroundControls" -> "MusicDatabase" [label="guarda ajustes",fontname="DejaVu Sans",fontsize=10];
}