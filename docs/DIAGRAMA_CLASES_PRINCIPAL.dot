digraph G {
graph [rankdir=TB, bgcolor="white", dpi=130, nodesep="0.46", ranksep="0.85", splines=true, pad="0.3", fontname="DejaVu Sans", label="MUSICAVATAR — DIAGRAMA DE CLASES PRINCIPAL", labelloc="t", fontsize="22", fontcolor="#352344"];
node [shape=plaintext, fontname="DejaVu Sans"];
edge [color="#877494",penwidth=1.2, arrowsize=0.7];
"MusicavatarWindow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#ebddfa" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>MusicavatarWindow</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+db: MusicDatabase</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+player: AudioPlayer</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+playback: PlaybackQueue</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+session: MoodSession</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+import_paths(paths)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+play_track(tid)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+play_all(shuffle)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+refresh_library()</FONT></TD></TR></TABLE>>];
"Track" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>Track</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+path: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+title: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+artist: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+genre: str</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+exists: bool</FONT></TD></TR></TABLE>>];
"MusicDatabase" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>MusicDatabase</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+add_track(data)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+all_tracks()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_mood(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+create_playlist(name)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+get_setting(...)</FONT></TD></TR></TABLE>>];
"AudioPlayer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>AudioPlayer</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+path: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+is_playing: bool</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+load_and_play(path)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+toggle_pause()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+seek(seconds)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+stop()</FONT></TD></TR></TABLE>>];
"PlaybackQueue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>PlaybackQueue</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+items: list</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+history: list</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+replace(track_ids)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+next_target(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+previous_target(...)</FONT></TD></TR></TABLE>>];
"MoodSession" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>MoodSession</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+mood: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+seconds: float</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+update(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+stage: int</FONT></TD></TR></TABLE>>];
"AvatarCanvas" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>AvatarCanvas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+mood: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+look: AvatarLook</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_state(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_customization(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_background_image(...)</FONT></TD></TR></TABLE>>];
"AvatarLook" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>AvatarLook</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+hair: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+outfit: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+pants: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+shoes: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+skin: str</FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+validated()</FONT></TD></TR></TABLE>>];
"TrackModel" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>TrackModel</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_tracks(tracks)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+replace_track(track)</FONT></TD></TR></TABLE>>];
"TrackFilter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#80629a" BGCOLOR="#faf8fd" STYLE="ROUNDED"><TR><TD BGCOLOR="#e7ddf1" CELLPADDING="9"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>TrackFilter</B></FONT></TD></TR><TR><TD HEIGHT="3" BGCOLOR="#c3b0d4"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_context(...)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">+set_filters(...)</FONT></TD></TR></TABLE>>];
{rank=same; "MusicDatabase"; "AudioPlayer"; "PlaybackQueue"; "MoodSession";}
{rank=same; "AvatarCanvas"; "TrackModel"; "TrackFilter";}
"MusicavatarWindow" -> "MusicDatabase" [label="persistencia",fontname="DejaVu Sans",fontsize="10"];
"MusicavatarWindow" -> "AudioPlayer" [label="audio",fontname="DejaVu Sans",fontsize="10"];
"MusicavatarWindow" -> "PlaybackQueue" [label="cola",fontname="DejaVu Sans",fontsize="10"];
"MusicavatarWindow" -> "MoodSession" [label="ánimo",fontname="DejaVu Sans",fontsize="10"];
"MusicavatarWindow" -> "AvatarCanvas" [label="avatar",fontname="DejaVu Sans",fontsize="10"];
"MusicavatarWindow" -> "TrackModel" [label="tabla",fontname="DejaVu Sans",fontsize="10"];
"MusicDatabase" -> "Track" [label="registros",fontname="DejaVu Sans",fontsize="10"];
"AvatarCanvas" -> "AvatarLook" [label="apariencia",fontname="DejaVu Sans",fontsize="10"];
"TrackFilter" -> "TrackModel" [label="filtra",fontname="DejaVu Sans",fontsize="10"];
}